+/// Validate the committed owning extent before performing any storage I/O.
+pub(crate) fn indexed_location(chunk: &crate::file_chunk::FileChunk) -> Result<u64> {
+    let descriptor = chunk.indexed_raw.as_ref().ok_or(Error::CorruptRecord)?;
+    let [segment] = chunk.segments.as_slice() else {
+        return Err(Error::CorruptRecord);
+    };
+    let logical_len =
+        usize::try_from(chunk.compression_frame_len).map_err(|_| Error::CorruptRecord)?;
+    let index_len = AuthenticatedBlockIndex::index_len(logical_len)? as u64;
+    if chunk.compression != crate::compression::COMPRESSION_NONE
+        || chunk.compressed_len != chunk.compression_frame_len
+        || segment.segment_offset != 0
+        || segment.segment_len != chunk.compressed_len
+        || descriptor.index_in_page < super::page::PAGE_HEADER_LEN as u64
+        || chunk
+            .compression_frame_offset
+            .checked_add(chunk.len)
+            .is_none_or(|end| end > chunk.compression_frame_len)
+    {
+        return Err(Error::CorruptRecord);
+    }
+    let end = descriptor
+        .index_in_page
+        .checked_add(index_len)
+        .and_then(|offset| offset.checked_add(chunk.compression_frame_len))
+        .ok_or(Error::CorruptRecord)?;
+    // Leave the page's integrity trailer outside the indexed data extent.
+    if end > segment.page_len.saturating_sub(32) {
+        return Err(Error::CorruptRecord);
+    }
+    segment
+        .page_offset
+        .checked_add(segment.page_len)
+        .ok_or(Error::CorruptRecord)?;
+    segment
+        .page_offset
+        .checked_add(descriptor.index_in_page)
+        .ok_or(Error::CorruptRecord)
+}
+
+pub(crate) fn read_chunk_range(
+    storage: &impl Storage,
+    chunk: &crate::file_chunk::FileChunk,
+    range: Range<u64>,
+) -> Result<Vec<u8>> {
+    if range.start > range.end || range.end > chunk.len {
+        return Err(Error::CorruptRecord);
+    }
+    let offset = indexed_location(chunk)?;
+    let descriptor = chunk.indexed_raw.as_ref().ok_or(Error::CorruptRecord)?;
+    let index = AuthenticatedBlockIndex::load(
+        storage,
+        offset,
+        chunk.compression_frame_id,
+        chunk.compression_frame_len as usize,
+        &descriptor.index_digest,
+    )?;
+    let start = usize::try_from(chunk.compression_frame_offset + range.start)
+        .map_err(|_| Error::CorruptRecord)?;
+    let end = usize::try_from(chunk.compression_frame_offset + range.end)
+        .map_err(|_| Error::CorruptRecord)?;
+    let mut bytes = index.read_range(storage, offset, start..end)?;
+    Ok(std::mem::take(&mut *bytes))
+}
