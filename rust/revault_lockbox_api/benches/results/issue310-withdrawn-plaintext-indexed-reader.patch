+        chunk.indexed_raw = Some(IndexedRawFrame {
+            index_in_page: 256,
+            index_digest: [71; 32],
+        });
+        let mut second = chunk.clone();
+        second.indexed_raw.as_mut().unwrap().index_digest[0] ^= 1;
+        let mut third = chunk.clone();
+        third.indexed_raw.as_mut().unwrap().index_in_page += 16;
+        let entry = TocEntry {
+            path: chunk.stored_path.clone(),
+            len: 384,
+            record_offset: 4096,
+            record_len: 4096,
+            record_object_id: 10,
+            deleted: false,
+            node_kind: NodeKind::File,
+            permissions: DEFAULT_FILE_PERMISSIONS,
+            chunks: vec![chunk, second, third],
+        };
+        let encoder = TocEncoder::new([&entry]);
+        assert_eq!(encoder.descriptors.len(), 3);
+        let encoded = encoder.encode();
+        assert_eq!(encoder.encoded_len(), encoded.len());
+        let decoded = decode_toc_entries(&encoded).unwrap();
+        assert_eq!(decoded[0].chunks, entry.chunks);
+        for end in 0..encoded.len() {
+            assert!(decode_toc_entries(&encoded[..end]).is_err());
+        }
+        for bad_offset in [0, 95, 4000, u64::MAX] {
+            let mut bad = entry.clone();
+            bad.chunks[0].indexed_raw.as_mut().unwrap().index_in_page = bad_offset;
+            assert!(decode_toc_entries(&TocEncoder::new([&bad]).encode()).is_err());
+        }
+        let mut bad = entry;
+        bad.chunks[0].compression = 1;
+        assert!(decode_toc_entries(&TocEncoder::new([&bad]).encode()).is_err());
+    }
 }
