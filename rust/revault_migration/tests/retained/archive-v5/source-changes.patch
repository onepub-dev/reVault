+pub(crate) fn read_description(payload: &[u8], offset: &mut usize) -> Result<Option<String>> {
+    let len = read_u32_le(payload.get(*offset..*offset+4).ok_or(Error::CorruptRecord)?)?;
+    *offset += 4;
+    if len == u32::MAX { return Ok(None); }
+    let end = offset.checked_add(len as usize).ok_or(Error::CorruptRecord)?;
+    let text = std::str::from_utf8(payload.get(*offset..end).ok_or(Error::CorruptRecord)?).map_err(|_| Error::CorruptRecord)?;
+    validate_variable_value_ref(text)?;
+    *offset = end;
+    Ok(Some(text.to_owned()))
