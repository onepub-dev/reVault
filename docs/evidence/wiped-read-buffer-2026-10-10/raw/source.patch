+#[test]
+fn raw_visit_still_refuses_authenticated_nonzero_internal_padding() {
+    let mode=mode(false,true,false,true);
+    let mut codec=Codec::new(archive(),mode,None).unwrap();
+    let (descriptor,mut bytes)=codec.encode([82;16],0,0,b"short plaintext").unwrap();
+    assert!(bytes.len()>descriptor.encoded_len as usize);
+    *bytes.last_mut().unwrap()=1;
+    let mut storage=StorageBackend::memory(vec![0;super::super::preparation_journal::DATA_START as usize]);
+    let start=storage.append(&bytes).unwrap();
+    let extent=allocation::Extent {start,len:bytes.len() as u64,digest:strong_checksum(&bytes)};
+    let mut exposed=false;
+    assert!(codec.with_loaded(&storage,extent,storage.len().unwrap(),&descriptor,|_|{exposed=true;Ok(())}).is_err());
+    assert!(!exposed);
+    assert!(codec.raw_scratch.iter().all(|b|*b==0));
+}
