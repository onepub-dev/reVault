+impl<S: Storage> TreeImage<S> {
+    fn variable(
+        &self,
+        name: &crate::VariableName,
+    ) -> Result<Option<crate::file_format::secure_segments::Layout>> {
+        self.image
+            .get(6, name.as_str().as_bytes())?
+            .map(|row| {
+                if self.image.version < 2 {
+                    return Err(Error::CorruptRecord);
+                }
+                crate::file_format::secure_segments::Layout::decode_metadata(
+                    &row.value,
+                    self.image.anchor.mode,
+                    self.image.anchor.sealed_len,
+                )
+            })
+            .transpose()
+    }
+    pub fn get_variable(&self, name: &crate::VariableName) -> Result<Option<String>> {
+        let Some(layout) = self.variable(name)? else {
+            return Ok(None);
+        };
+        if layout.sensitivity == crate::VariableSensitivity::Secret {
+            return Err(Error::InvalidOperation(
+                "variable is secret; use secret access".into(),
+            ));
+        }
+        let bytes = layout.read(
+            &self.image.storage,
+            self.image.anchor.archive,
+            &*self.image.value_key()?,
+            self.image.anchor.sealed_len,
+        )?;
+        bytes.with_bytes(|bytes| {
+            Ok(Some(
+                std::str::from_utf8(bytes)
+                    .map_err(|_| Error::CorruptRecord)?
+                    .to_owned(),
+            ))
+        })?
+    }
+    pub fn with_secret_variable<R>(
+        &self,
+        name: &crate::VariableName,
+        f: impl FnOnce(&crate::SecretString) -> R,
+    ) -> Result<Option<R>> {
+        let Some(layout) = self.variable(name)? else {
+            return Ok(None);
+        };
+        if layout.sensitivity != crate::VariableSensitivity::Secret {
+            return Err(Error::InvalidOperation("variable is not secret".into()));
+        }
+        let bytes = layout.read(
+            &self.image.storage,
+            self.image.anchor.archive,
+            &*self.image.value_key()?,
+            self.image.anchor.sealed_len,
+        )?;
+        let value = std::sync::Arc::new(crate::SecretString::from_secure_vec(bytes));
+        Ok(Some(f(&value)))
+    }
+    pub fn get_form_definition(
+        &self,
+        id: &crate::FormTypeId,
+        revision: u32,
+    ) -> Result<Option<crate::FormDefinition>> {
+        let forms = super::super::dense_catalogue::forms::Forms::selected_definition(
+            id,
+            revision,
+            self.image.anchor.mode,
+            self.image.anchor.sealed_len,
+            |n, k| self.image.get(n, k),
+        )?;
+        if self.image.version < 3 && !forms.is_empty() {
+            return Err(Error::CorruptRecord);
+        }
+        forms
+            .definitions
+            .first()
+            .map(|d| {
+                d.read(
+                    &self.image.storage,
+                    self.image.anchor.archive,
+                    &*self.image.value_key()?,
+                    self.image.anchor.sealed_len,
+                )
+            })
+            .transpose()
+    }
+    fn selected_form(
+        &self,
+        path: &LockboxPath,
+    ) -> Result<super::super::dense_catalogue::forms::Forms> {
+        let forms = super::super::dense_catalogue::forms::Forms::selected_record(
+            path,
+            self.image.anchor.mode,
+            self.image.anchor.sealed_len,
+            |n, k| self.image.get(n, k),
+        )?;
+        if self.image.version < 3 && !forms.is_empty() {
+            return Err(Error::CorruptRecord);
+        }
+        Ok(forms)
+    }
+    pub fn get_form_record(&self, path: &LockboxPath) -> Result<Option<crate::FormRecord>> {
+        let forms = self.selected_form(path)?;
+        forms
+            .records
+            .first()
+            .map(|r| {
+                r.read(
+                    &self.image.storage,
+                    self.image.anchor.archive,
+                    &*self.image.value_key()?,
+                    self.image.anchor.sealed_len,
+                )
+            })
+            .transpose()
+    }
+    pub fn with_form_field_value<R>(
+        &self,
+        path: &LockboxPath,
+        id: &str,
+        f: impl FnOnce(&crate::FormValue) -> R,
+    ) -> Result<Option<R>> {
+        let forms = self.selected_form(path)?;
+        let Some(field) = forms
+            .records
+            .first()
+            .and_then(|r| r.fields.iter().find(|f| f.id == id))
+        else {
+            return Ok(None);
+        };
+        let value = field.read_value(
+            &self.image.storage,
+            self.image.anchor.archive,
+            &*self.image.value_key()?,
+            self.image.anchor.sealed_len,
+        )?;
+        Ok(Some(f(&value)))
+    }
+}
