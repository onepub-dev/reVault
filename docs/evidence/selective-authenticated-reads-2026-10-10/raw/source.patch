+                .get_cached(&storage, root, sealed, 1, b"name", &mut cache)
+                .unwrap()
+                .unwrap()
+                .value
+                .as_slice(),
+            b"original"
+        );
+        assert!(index
+            .get_cached(&storage, root, REGION_LEN as u64, 1, b"name", &mut cache)
+            .is_err());
+    }
+}
