+fn dense_full_slot_seed(mode:FormatMode,authority:&Authority<'_>,signer:Option<&OwnerSigningKeyPair>)->StorageBackend {
+    use crate::file_format::publication_anchor::{shared,REGION_LEN};
+    let mut storage=dense_seed(mode,authority,signer);
+    let (_,body)=shared::open_private(&storage,archive(),mode,authority,key(mode)).unwrap();
+    storage.write_at(0,&vec![0;REGION_LEN]).unwrap();
+    shared::initialize(&mut storage,archive(),mode,authority,signer,key(mode),&body,&[]).unwrap();
+    storage
+}
