+#[test]
+fn dense_private_catalogue_growth_and_shrink_reuse_external_control_space() {
+    use crate::file_format::publication_anchor::{shared,REGION_LEN};
+    let owner=OwnerSigningKeyPair::generate().unwrap();let public=owner.public_key();
+    for encrypted in [false,true] {for signed in [false,true] {
+        let mode=mode(encrypted,signed,false,true);let authority=authority(mode,&public);let signer=signed.then_some(&owner);
+        let names:Vec<_>=(0..200).map(|index|format!("file-{index:04}-{}","a".repeat(44)).into_bytes()).collect();
+        let inputs=names.iter().map(|path|Input {path:path.clone(),reader:Cursor::new(Vec::new())});
+        let source=Files::create(StorageBackend::memory(Vec::new()),archive(),mode,&authority,signer,key(mode),65536,inputs).unwrap();
+        let mut source=Files::open(source,archive(),mode,&authority,key(mode)).unwrap();
+        let mut storage=super::dense_image::from_candidate(&mut source,StorageBackend::memory(Vec::new()),&authority,signer,key(mode),&[]).unwrap();
+        let (initial,_)=shared::snapshot(&storage,archive(),mode,&authority,key(mode)).unwrap();
+        assert_eq!(initial.index.len,24576);assert_eq!(initial.sealed_len,REGION_LEN as u64);
+        let long=vec![b'x';4096];let mut high_water=0;
+        for cycle in 0..8 {
+            let grow=cycle%2==0;let (from,to)=if grow {(names[0].as_slice(),long.as_slice())}else{(long.as_slice(),names[0].as_slice())};
+            assert!(super::dense_update::edit(&mut storage,archive(),mode,&authority,signer,key(mode),from,to,None).unwrap());
+            let (anchor,body)=shared::open_private(&storage,archive(),mode,&authority,key(mode)).unwrap();
+            assert_eq!(anchor.index.len,if grow {49152}else{24576});
+            assert_eq!(anchor.index.primary>=REGION_LEN as u64,grow);
+            if cycle==0 {high_water=anchor.sealed_len;}else{assert_eq!(anchor.sealed_len,high_water);}
+            let codec=Codec::shared_packed(archive(),mode,key(mode)).unwrap();let catalogue=super::dense_catalogue::Catalogue::decode(&body,&codec,anchor.sealed_len).unwrap();
+            catalogue.graph(&anchor).unwrap().verify_reclaimed(&storage).unwrap();
+            assert_eq!(catalogue.files.len(),200);assert!(catalogue.files.iter().any(|file|file.path.as_slice()==to));assert!(!catalogue.files.iter().any(|file|file.path.as_slice()==from));
+            let mut image=super::dense_image::Image::open(StorageBackend::memory(storage.read_all().unwrap()),archive(),mode,&authority,key(mode)).unwrap();
+            for name in names.iter().skip(1) {image.read_range(name,0,0,|_|panic!("empty file returned data")).unwrap();}
+            image.read_range(to,0,0,|_|panic!("empty file returned data")).unwrap();
+        }
+    }}
