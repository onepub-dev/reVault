+#[test]
+fn dense_password_bootstrap_still_reads_files_after_inline_metadata_updates() {
+    use crate::file_format::publication_anchor::bootstrap::Credential;
+    let owner=OwnerSigningKeyPair::generate().unwrap();let public=owner.public_key();
+    let mode=mode(true,true,true,true);let authority=authority(mode,&public);
+    let mut source=Files::open(packed_pair(mode,&authority,Some(&owner)),archive(),mode,&authority,key(mode)).unwrap();
+    let slots=[crate::key_slot::KeySlot::password_bytes(1,b"synthetic lane password",vec![94;16],KEY).unwrap()];
+    let mut storage=super::dense_image::from_candidate(&mut source,StorageBackend::memory(Vec::new()),&authority,Some(&owner),key(mode),&slots).unwrap();
+    for name in [b"renamed".as_slice(),b"erase".as_slice()] {
+        let from=if name==b"renamed" {b"erase".as_slice()}else{b"renamed".as_slice()};
+        super::dense_update::edit(&mut storage,archive(),mode,&authority,Some(&owner),key(mode),from,name,None).unwrap();
+        let password=crate::SecretString::try_from_slice(b"synthetic lane password").unwrap();
+        let mut image=super::dense_image::Image::open_credential(StorageBackend::memory(storage.read_all().unwrap()),archive(),mode,Some(&public),Credential::Password(&password),Some(1)).unwrap();
+        let mut data=Vec::new();image.read_range(name,0,4096,|part|{data.extend_from_slice(part);Ok(())}).unwrap();assert_eq!(data,vec![0xa7;4096]);
+    }
+}
