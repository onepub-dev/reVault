+#[test]
+fn private_slot_growth_requires_all_previous_subranges_to_be_vacant() {
+    let (anchor,packs,_)=initial();
+    let (external,mut vacant)=external(&anchor);
+    vacant.retain(|entry|entry.span.start>=REGION_LEN as u64 || entry.span.len==4096);
+    for bank in [0,FAILURE_REGION] {
+        vacant.push(Vacant {span:Span {start:bank+PRIVATE_START,len:24576},kind:VacantKind::Free});
+        vacant.push(Vacant {span:Span {start:bank+PRIVATE_START+24576,len:24576},kind:VacantKind::Pending});
+    }
+    let old=Graph::derive(&external,&packs,&vacant).unwrap();
+    let next=advance(&external,RootRef {digest:[9;32],..anchor.index},external.sealed_len);
+    let mut retired=key_slots();
+    for start in [external.index.primary,external.index.mirror] {
+        retired.push(Vacant {span:Span {start,len:PRIVATE_BYTES as u64},kind:VacantKind::Pending});
+        retired.push(Vacant {span:Span {start:start+PRIVATE_BYTES as u64,len:FAILURE_REGION-PRIVATE_BYTES as u64},kind:VacantKind::Free});
+    }
+    let next=Graph::derive(&next,&packs,&retired).unwrap();
+    let plan=old.transition_to(&next).unwrap();assert_eq!(plan.writes.len(),2);
+    assert_eq!(plan.erase_before_write,vec![Span {start:40960,len:24576},Span {start:106496,len:24576}]);
+    // Free first halves cannot authorize overwrite of live second halves.
+    let mut live=anchor.clone();live.index=RootRef {primary:40960,mirror:106496,len:24576,digest:[7;32]};live.object_root=live.index.digest;
+    let mut vacant=key_slots();for bank in [0,FAILURE_REGION] {vacant.push(Vacant {span:Span {start:bank+PRIVATE_START,len:24576},kind:VacantKind::Free});}
+    let old=Graph::derive(&live,&packs,&vacant).unwrap();
+    let next=advance(&live,anchor.index,anchor.sealed_len);
+    assert!(old.transition_to(&Graph::derive(&next,&packs,&key_slots()).unwrap()).is_err());
+}
