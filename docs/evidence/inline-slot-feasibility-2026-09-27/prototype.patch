+            let mode=FormatMode::new(LockboxFormatOptions {encryption:if encrypted {EncryptionMode::ChaCha20Poly1305}else{EncryptionMode::None},signing:if signed {SigningMode::Owner}else{SigningMode::None},compression:Compression::None,size_padding:SizePadding::Default});
+            let codec=Codec::new(archive,mode,encrypted.then_some(key.as_slice())).unwrap();
+            let short_limit=PRIVATE_BYTES/2-HEADER-BODY_HEADER-if encrypted {16}else{0};
+            for len in [0,short_limit,short_limit+1,40000] {
+                let plain=vec![0x52;len];let encoded=codec.encode_compact(&plain).unwrap();
+                assert_eq!(encoded.len(),if len<=short_limit {PRIVATE_BYTES/2}else{PRIVATE_BYTES});
+                assert_eq!(codec.decode(&encoded).unwrap().as_slice(),plain);
+                if len>short_limit {assert!(codec.encode_sized(&plain,PRIVATE_BYTES/2).is_err());assert!(codec.decode(&encoded[..PRIVATE_BYTES/2]).is_err());}
+                else {let mut extended=encoded.to_vec();extended.resize(PRIVATE_BYTES,0);assert!(codec.decode(&extended).is_err());}
