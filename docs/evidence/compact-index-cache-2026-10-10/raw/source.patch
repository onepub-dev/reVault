+// One compact allocation owns the private bytes in a decoded leaf. Offsets
+// replace per-record key/value allocations without retaining borrowed storage.
+// The shared decoder validates the entire page before this representation exists.
+pub(super) enum CachedNode {
+    Leaf(Leaf),
+    Branch { height: u8, children: Vec<Link> },
+}
+pub(super) struct Leaf {
+    bytes: ZeroizingBytes,
+    rows: Vec<Row>,
+}
+struct Row {
+    namespace: u8,
+    start: usize,
+    key_end: usize,
+    end: usize,
+}
+impl Leaf {
+    pub(super) fn new(entries: Vec<EntryRef<'_>>) -> Self {
+        let size = entries.iter().map(|e| e.key.len() + e.value.len()).sum();
+        let mut bytes = ZeroizingBytes::new(Vec::with_capacity(size));
+        let mut rows = Vec::with_capacity(entries.len());
+        for entry in entries {
+            let start = bytes.len();
+            bytes.extend_from_slice(entry.key);
+            let key_end = bytes.len();
+            bytes.extend_from_slice(entry.value);
+            rows.push(Row { namespace: entry.namespace, start, key_end, end: bytes.len() });
+        }
+        Self { bytes, rows }
+    }
+    fn identity(&self, row: &Row) -> (u8, &[u8]) {
+        (row.namespace, &self.bytes[row.start..row.key_end])
+    }
+    fn get(&self, identity: (u8, &[u8])) -> Result<Option<Entry>> {
+        self.rows.binary_search_by(|row| self.identity(row).cmp(&identity)).ok()
+            .map(|i| {
+                let row = &self.rows[i];
+                Entry::new(row.namespace, &self.bytes[row.start..row.key_end], &self.bytes[row.key_end..row.end])
+            }).transpose()
+    }
+}
+impl CachedNode {
+    fn height(&self) -> u8 { match self { Self::Leaf(_) => 0, Self::Branch {height,..} => *height } }
+    fn count(&self) -> u64 { match self { Self::Leaf(leaf) => leaf.rows.len() as u64, Self::Branch {children,..} => children.iter().map(|c| c.count).sum() } }
+    fn first(&self) -> Option<(u8,&[u8])> { match self { Self::Leaf(leaf) => leaf.rows.first().map(|row| leaf.identity(row)), Self::Branch {children,..} => children.first().map(|c| c.first.identity()) } }
+    fn last(&self) -> Option<(u8,&[u8])> { match self { Self::Leaf(leaf) => leaf.rows.last().map(|row| leaf.identity(row)), Self::Branch {children,..} => children.last().map(|c| c.first.identity()) } }
+}
+impl Index {
+    fn read_cached_node(&self, storage: &impl Storage, reference: RootRef, sealed: u64) -> Result<CachedNode> {
+        validate_ref(reference,sealed)?;
+        let bytes = ZeroizingBytes::new(reference.read_verified(storage)?);
+        self.decode_cached_node(&bytes,sealed)
+    }
+}
