node -e "const assert=require(\"node:assert/strict\"); const {WasmLockbox,set_weakened_allocation_allowed}=require(\"./bindings/wasm/generated/revault_wasm_bindings.cjs\"); set_weakened_allocation_allowed(true); const pass=\"binding budget lifecycle\"; const expected=Buffer.from(\"explicit-budget-reopen\"); let bytes; let box=WasmLockbox.create_with_password(pass); try { box.add_file(\"/pending\",expected,false); box.commit(); bytes=Buffer.from(box.to_bytes()); } finally { box.free(); } for (const invalid of [-1,0.5,4294967296,NaN,Infinity]) assert.throws(()=>WasmLockbox.open_with_password_budget(bytes,pass,invalid), /max_derivations must be an unsigned 32-bit integer/); box=WasmLockbox.open_with_password_budget(bytes,pass,1); try { assert.deepEqual(Buffer.from(box.get_file(\"/pending\")),expected); box.add_file(\"/pending\",Buffer.from(\"committed-with-budget\"),true); box.commit(); bytes=Buffer.from(box.to_bytes()); } finally { box.free(); } box=WasmLockbox.open_with_password_budget(bytes,pass,1); try { assert.deepEqual(Buffer.from(box.get_file(\"/pending\")),Buffer.from(\"committed-with-budget\")); } finally { box.free(); } console.log(\"invalid budget shapes refused; explicit budget open/commit/free/reopen bytes passed\");"
