+    /// Transfer the facade while retaining its allocation ownership tag.
+    /// Ordinary returns, early errors and unwinding all keep borrowed storage
+    /// non-owning. The lease is only a normal-return identity check.
+    pub(crate) fn lease_vec(self) -> (Self, VecLease<T>) {
+        let lease = VecLease { owned: self.owned, ptr: self.inner.as_ptr() as *mut T, capacity: self.inner.capacity() };
+        (self, lease)
+    }
+
+    pub(crate) fn recover_vec(value: Self, lease: VecLease<T>) -> Self {
