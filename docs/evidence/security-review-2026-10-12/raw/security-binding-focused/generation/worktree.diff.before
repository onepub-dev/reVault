+    }
+
+    /// Reinterpret initialized elements without changing storage ownership.
+    ///
+    /// # Safety
+    /// T and U must have identical size/alignment and every initialized T must
+    /// be valid as U, including compatible destruction semantics.
+    pub(crate) unsafe fn cast<U>(self) -> ReusableVec<U> {
+        assert_eq!(core::mem::size_of::<T>(), core::mem::size_of::<U>());
+        assert_eq!(core::mem::align_of::<T>(), core::mem::align_of::<U>());
+        let (ptr, len, capacity, owned) = self.into_raw_parts();
+        ReusableVec {
+            inner: ManuallyDrop::new(unsafe { Vec::from_raw_parts(ptr.cast::<U>(), len, capacity) }),
+            owned,
