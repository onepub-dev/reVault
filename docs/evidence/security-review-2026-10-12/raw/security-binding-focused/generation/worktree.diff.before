+fn output_error(error: std::io::Error) -> Error {
+    #[cfg(unix)]
+    let component_refused = matches!(error.raw_os_error(), Some(libc::ELOOP) | Some(libc::ENOTDIR));
+    #[cfg(not(unix))]
+    let component_refused = false;
+    if matches!(error.kind(), std::io::ErrorKind::AlreadyExists | std::io::ErrorKind::PermissionDenied)
+        || component_refused {
+        Error::SecurityLimitExceeded(format!("output refused (existing destination or symlink component): {error}"))
+    } else {
+        Error::Io(error.to_string())
+    }
+}
+
+fn extraction_relative(path: &crate::LockboxPath) -> Result<PathBuf> {
+    canonicalize_stored_path(path.as_str(), false)?;
+    let relative = PathBuf::from(path.as_str().trim_start_matches('/'));
+    if relative.components().any(|c| !matches!(c, Component::Normal(_))) {
+        return Err(Error::InvalidPath(path.to_string()));
+    }
+    Ok(relative)
+}
