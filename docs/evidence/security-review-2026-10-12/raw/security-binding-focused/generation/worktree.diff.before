 #[cfg(test)]
 mod tests {
     use super::*;
+
+    #[test]
+    fn request_deadline_is_shared_by_reads_and_writes() {
+        let (left, mut right) = UnixStream::pair().unwrap();
+        let mut stream = DeadlineStream::new(left);
+        right.write_all(b"a").unwrap();
+        let mut byte = [0];
+        stream.read_exact(&mut byte).unwrap();
+        assert_eq!(&byte, b"a");
+        stream.deadline = Instant::now() - Duration::from_secs(1);
+        assert_eq!(stream.read(&mut byte).unwrap_err().kind(), io::ErrorKind::TimedOut);
+        assert_eq!(stream.write(b"b").unwrap_err().kind(), io::ErrorKind::TimedOut);
+    }
+
