+        let Self::File(source) = self else {
+            return Err(Error::InvalidOperation("permission preservation requires file-backed storage".into()));
+        };
+        let source_file = source.lock_file()?;
+        source.ensure_current(&source_file)?;
+        private_archive_file::copy_permissions(&source_file, destination).map_err(|e| Error::Io(e.to_string()))
+    }
