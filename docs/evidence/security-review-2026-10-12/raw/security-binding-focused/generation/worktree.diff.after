+    /// Extract one file with limits and permission restoration applied before
+    /// atomic publication. A failed read leaves any existing destination intact.
+    pub fn extract_file_to_with_policy(
+        &self, source: &LockboxPath, destination: &Path, policy: &crate::ExtractPolicy,
+    ) -> Result<()> {
+        let path = source.as_file_path()?;
+        let entry = self.toc_entries.get(path).filter(|entry| !entry.deleted && entry.node_kind == crate::node_kind::NodeKind::File)
+            .ok_or_else(|| Error::NotFound(source.to_string()))?;
+        if policy.max_files == 0 || entry.len > policy.max_file_bytes || entry.len > policy.max_total_bytes {
+            return Err(Error::SecurityLimitExceeded("file exceeds extraction limits".into()));
+        }
+        self.extract_file_to_staged(source, destination, policy.overwrite, false,
+            policy.restore_permissions.then_some(entry.permissions))
+    }
+
+    fn extract_file_to_staged(&self, source: &LockboxPath, destination: &Path,
+        overwrite: bool, require_existing: bool, permissions: Option<u32>) -> Result<()> {
+        let map_error = |error: std::io::Error| match error.kind() {
+            std::io::ErrorKind::AlreadyExists => Error::AlreadyExists(destination.display().to_string()),
+            std::io::ErrorKind::NotFound => Error::NotFound(destination.display().to_string()),
+            _ => Error::Io(error.to_string()),
+        };
+        let mut staged = super::secure_output::StagedFile::at(destination, require_existing).map_err(map_error)?;
+        self.extract_file_to_writer(source, staged.writer())?;
+        staged.publish(overwrite, permissions).map_err(map_error)
     }
 
