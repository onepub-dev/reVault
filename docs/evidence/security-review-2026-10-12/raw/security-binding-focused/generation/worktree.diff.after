+/// Sensitive compression never enters the allocating legacy codec fallback.
+pub(crate) fn encode_sensitive_outcome(
+    payload: &[u8], compression: Option<crate::Compression>, default_level: i32,
+) -> FrameEncoding {
+    let level = match compression {
+        Some(crate::Compression::None) => return FrameEncoding::Raw,
+        Some(crate::Compression::Zstd { level }) => CompressionLevel::new(level.get()).expect("validated level"),
+        None => zstd_complete_level(default_level),
+    };
+    encode_workspace::encode_sensitive(payload, level)
+}
+
+pub(crate) fn encode_with_compression_sensitive(
+    payload: &[u8], compression: crate::Compression, sensitive: bool,
+) -> (u8, Vec<u8>) {
+    if sensitive { encode_sensitive_outcome(payload, Some(compression), ZSTD_DEFAULT_LEVEL).into_encoded(payload) }
+    else { encode_with_compression(payload, compression) }
+}
