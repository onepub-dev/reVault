+
+    #[test]
+    fn password_budget_and_private_extraction_abi_lifecycle() {
+        let password = b"ordinary ABI password";
+        let source = b"/payload";
+        let data = b"persisted through separate password open";
+        let root = std::env::temp_dir().join(format!("revault-security-abi-{}", revault_lockbox_api::LockboxId::new_random().unwrap()));
+        std::fs::create_dir(&root).unwrap();
+        let destination = root.join("output");
+        let destination_text = destination.to_str().unwrap();
+        unsafe {
+            let handle = lockbox_create_password(password.as_ptr(), password.len());
+            assert!(!handle.is_null());
+            assert!(lockbox_add_file_with_permissions(handle, source.as_ptr().cast(), source.len(), data.as_ptr(), data.len(), 0o600, false));
+            assert!(lockbox_commit(handle));
+            let archive = lockbox_to_bytes(handle);
+            assert!(!archive.ptr.is_null());
+            lockbox_free(handle);
+            assert!(lockbox_open_password_with_budget(archive.ptr, archive.len, password.as_ptr(), password.len(), 0).is_null());
+            let opened = lockbox_open_password_with_budget(archive.ptr, archive.len, password.as_ptr(), password.len(), 1);
+            assert!(!opened.is_null());
+            buffer_free(archive);
+            assert!(!lockbox_extract_file_with_policy(opened, source.as_ptr().cast(), source.len(), destination_text.as_ptr().cast(), destination_text.len(), 1, 1, 1, true, false));
+            assert!(!destination.exists());
+            assert!(lockbox_extract_file_with_policy(opened, source.as_ptr().cast(), source.len(), destination_text.as_ptr().cast(), destination_text.len(), 1024, 1024, 1, true, false));
+            assert_eq!(std::fs::read(&destination).unwrap(), data);
+            #[cfg(unix)] {
+                use std::os::unix::fs::PermissionsExt;
+                assert_eq!(std::fs::metadata(&destination).unwrap().permissions().mode() & 0o777, 0o600);
+            }
+            std::fs::write(&destination, b"existing destination sentinel").unwrap();
+            assert!(!lockbox_extract_file_with_policy(opened, source.as_ptr().cast(), source.len(), destination_text.as_ptr().cast(), destination_text.len(), 1024, 1024, 1, true, false));
+            assert_eq!(std::fs::read(&destination).unwrap(), b"existing destination sentinel");
+            assert!(lockbox_extract_file_with_policy(opened, source.as_ptr().cast(), source.len(), destination_text.as_ptr().cast(), destination_text.len(), 1024, 1024, 1, true, true));
+            assert_eq!(std::fs::read(&destination).unwrap(), data);
+            lockbox_free(opened);
+        }
+        std::fs::remove_dir_all(root).unwrap();
+    }
+
     #[test]
     fn cache_limit_abi_validates_policy_and_preserves_pending_content() {
         let key = [31u8; 32];
@@ -8527,3 +8568,92 @@ mod tests {
