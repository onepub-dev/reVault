+#[cfg(test)]
+mod sensitive_encoder_tests {
+    use super::*;
+
+    #[test]
+    fn sensitive_frames_roundtrip_all_supported_levels_and_boundary_sizes() {
+        for size in [0usize, 1, 63, 65_535, 65_536, 131_073] {
+            let input: Vec<u8> = (0..size).map(|i| ((i / 97 + i % 13) % 251) as u8).collect();
+            for level in 1..=22 {
+                let compression = crate::Compression::Zstd { level: crate::ZstdLevel::new(level).unwrap() };
+                let (codec, bytes) = encode_with_compression_sensitive(&input, compression, true);
+                assert_eq!(decode_compression_frame(codec, &bytes, size as u64).unwrap(), input);
+            }
+        }
+    }
+
+    #[test]
+    fn clear_only_encoding_keeps_existing_bytes_and_sensitive_none_stays_raw() {
+        let input = vec![37u8; 4097];
+        for level in [1, 3, 9, 18, 22] {
+            let compression = crate::Compression::Zstd { level: crate::ZstdLevel::new(level).unwrap() };
+            assert_eq!(encode_with_compression_sensitive(&input, compression, false), encode_with_compression(&input, compression));
+        }
+        assert_eq!(encode_with_compression_sensitive(&input, crate::Compression::None, true), (COMPRESSION_NONE, input));
+    }
+}
