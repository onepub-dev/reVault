+#[test]
+fn password_work_override_preserves_ordinary_archive_and_mirror_readability() {
+    let first = password("budget first");
+    let second = password("budget second");
+    let wrong = password("budget other");
+    let mut archive = Lockbox::create_with_password(&first).unwrap();
+    add_file(&mut archive, &p("/budget/data"), b"ordinary retained bytes", false).unwrap();
+    archive.commit().unwrap();
+    archive.add_password(&second).unwrap();
+    archive.commit().unwrap();
+    let bytes = archive.to_bytes();
+    assert!(matches!(Lockbox::open_with_password_budget(bytes.clone(), &first, 0), Err(Error::SecurityLimitExceeded(_))));
+    assert!(matches!(Lockbox::open_with_password_budget(bytes.clone(), &second, 1), Err(Error::SecurityLimitExceeded(_))));
+    let opened = Lockbox::open_with_password_budget(bytes.clone(), &second, 2).unwrap();
+    assert_eq!(opened.get_file(&p("/budget/data")).unwrap(), b"ordinary retained bytes");
+    assert_eq!(Lockbox::open_with_password(bytes.clone(), &second).unwrap().get_file(&p("/budget/data")).unwrap(), b"ordinary retained bytes");
+    // Two distinct slots are sufficient even when their mirror repeats the
+    // same failed wrapping inputs. No archive validity limit was introduced.
+    assert!(matches!(Lockbox::open_with_password_budget(bytes.clone(), &wrong, 2), Err(Error::InvalidKey)));
+    assert_eq!(archive.to_bytes(), bytes);
+}
+
+#[cfg(feature = "vault-integration")]
+#[test]
+fn password_budget_keeps_successful_unwrap_available_to_backup_candidate() {
+    let password = password("candidate fallback credential");
+    let mut archive = Lockbox::create_with_password(&password).unwrap();
+    add_file(&mut archive, &p("/data"), b"candidate data", false).unwrap();
+    archive.commit().unwrap();
+    let backup = crate::vault_integration::VaultOpen::export_key_directory_backup(&archive).unwrap();
+    let bytes = archive.to_bytes();
+    let mut budget = crate::PasswordWorkBudget::new(&password, 2);
+    // Consider the same legitimate wrapping inputs again for another
+    // candidate; success may not be converted into a cached password miss.
+    for _ in 0..2 {
+        let opened = crate::vault_integration::VaultOpen::key_directory_backup_with_password_budget(&backup, &mut budget).unwrap();
+        assert_eq!(opened.open_bytes(bytes.clone()).unwrap().read_file_range(&p("/data"), 0, 14).unwrap(), b"candidate data");
+    }
+    assert!(matches!(crate::vault_integration::VaultOpen::key_directory_backup_with_password_budget(&backup, &mut budget), Err(Error::SecurityLimitExceeded(_))));
+}
