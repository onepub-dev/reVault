+    /// Opens using an explicit per-credential KDF budget for a trusted archive.
+    pub fn open_with_password_budget(bytes: &[u8], password: &str, max_derivations: f64) -> Result<WasmLockbox, JsValue> {
+        if !max_derivations.is_finite() || max_derivations.fract() != 0.0 || max_derivations < 0.0 || max_derivations > u32::MAX as f64 {
+            return Err(JsValue::from_str("max_derivations must be an unsigned 32-bit integer"));
+        }
+        let password = SecretString::try_from_slice(password.as_bytes())
+            .map_err(|value| JsValue::from_str(&value.to_string()))?;
+        Lockbox::open_with_password_budget(bytes.to_vec(), &password, max_derivations as u32)
+            .map(WasmLockbox).map_err(error)
+    }
